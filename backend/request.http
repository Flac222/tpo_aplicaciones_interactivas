@baseUrl = http://localhost:3000
@userId = da2abc8c-3193-4d96-b6d4-cf207266b5fc
@equipoId = e84a6f88-9dff-4ce9-ba41-ba38206bb9fe
@tareaId = 0d33e900-fdc0-4c29-9797-95157097aea3
